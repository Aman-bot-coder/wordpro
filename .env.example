# --- Database (required) -----------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/wrds_seo
# Set to true if your Postgres requires SSL (most managed providers do)
DATABASE_SSL=false

# --- Admin panel (required) --------------------------------------------------
# Password for /admin
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie
SEO_SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Site --------------------------------------------------------------------
# Only a fallback; the live value is edited in /admin/settings
NEXT_PUBLIC_SITE_URL=https://wrds.pro

# Persistent directory for uploaded media (absolute path on the server)
UPLOAD_DIR=/home/soft/apps/wordpro/uploads

# Contact form email (Zoho SMTP). Enquiries are sent to CONTACT_TO.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@wrds.pro
SMTP_PASS=
CONTACT_TO=info@wrds.pro
CONTACT_FROM=info@wrds.pro
